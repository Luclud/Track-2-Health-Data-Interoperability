# Copy to .env. All values are for the local demo / agents. No real secrets.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=data
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# dev = X-Dev-User header (standalone website, tests); matrix = widget OpenID token verified at Synapse
AUTH_MODE=dev

FHIR_BASE_URL=http://localhost:8090/fhir
# On the public server https://hapi.fhir.org/baseR4 use a unique id, e.g. brieftaube-maria-beispiel
SCENARIO_PATIENT_ID=maria-beispiel

# memory = standalone website timeline; matrix = post into the Element room (needs `npm run seed` first)
CHAT_MODE=memory
SYNAPSE_URL=http://localhost:8008
MATRIX_SERVER_NAME=klinikum.example
# Filled automatically from data/runtime.json written by `npm run seed`; set here only to override
MATRIX_BOT_TOKEN=
MATRIX_ROOM_ID=

# smtp = Mailpit; memory = keep in RAM (unit tests)
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025/api/v1

EID_ISSUER_URL=http://localhost:3000/mock-eid

# LLM fallback for documents the parser cannot read: none | anthropic | perplexity | openai-compatible | mock
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Image overrides (defaults are mirrors that avoid Docker Hub rate limits)
# SYNAPSE_IMAGE=matrixdotorg/synapse:latest
# ELEMENT_IMAGE=vectorim/element-web:latest
# HAPI_IMAGE=hapiproject/hapi:latest
# MAILPIT_IMAGE=axllent/mailpit:latest
